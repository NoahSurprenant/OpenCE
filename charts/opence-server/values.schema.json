{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "opence-server values",
  "description": "Strict where the chart defines the structure (unknown keys and wrong types fail the render); free-form where values pass through to Kubernetes. values.yaml describes each value.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "k8sObject": { "type": "object" },
    "k8sList": { "type": "array" },
    "storageSize": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$" },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "exec": false,
        "httpGet": false,
        "tcpSocket": false,
        "grpc": false,
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "gameEntry": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(:[A-Za-z0-9_.-]+)?$" }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "number"] },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "gameData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": { "type": "string" },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "volume": { "$ref": "#/definitions/k8sObject" },
        "subPath": { "type": "string" }
      }
    },
    "customMaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": { "type": "string" },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "volume": { "$ref": "#/definitions/k8sObject" },
        "subPath": { "type": "string" },
        "readOnly": { "type": "boolean" }
      }
    },
    "skateData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": { "type": "string" },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "volume": { "$ref": "#/definitions/k8sObject" },
        "subPath": { "type": "string" }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": { "type": "string" },
        "volume": { "$ref": "#/definitions/k8sObject" },
        "subPath": { "type": "string" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/gameEntry" } },
        "gameTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" } },
        "timeLimit": { "type": "integer", "minimum": 0 },
        "scoreLimit": { "type": "integer", "minimum": 0 },
        "bots": { "type": "integer", "minimum": 0, "maximum": 16 },
        "botDifficulty": { "type": "string", "enum": ["peaceful", "easy", "normal", "hard", "legendary"] },
        "botSkaters": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tunnelPort": { "$ref": "#/definitions/port" },
        "publicAddress": { "type": "string", "pattern": "^([A-Za-z0-9.-]+(:[0-9]{1,5})?)?$" },
        "hostPublic": { "type": "boolean" },
        "serverName": { "type": "string" },
        "allowUpnp": { "type": "boolean" },
        "online": { "type": "boolean" },
        "stunServers": { "type": "string" }
      }
    },
    "telnetConsole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "size": { "$ref": "#/definitions/storageSize" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
        },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "emptyDirSizeLimit": { "$ref": "#/definitions/storageSize" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/port" },
        "nodePort": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 65535 }, { "const": "" }] },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "externalTrafficPolicy": { "enum": ["", "Cluster", "Local"] },
        "loadBalancerClass": { "type": "string" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } }
      }
    },
    "strategy": {
      "type": "object",
      "properties": { "type": { "enum": ["Recreate", "RollingUpdate"] } }
    },
    "resources": { "$ref": "#/definitions/k8sObject" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "affinity": { "$ref": "#/definitions/k8sObject" },
    "tolerations": { "$ref": "#/definitions/k8sList" },
    "priorityClassName": { "type": "string" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podSecurityContext": { "$ref": "#/definitions/k8sObject" },
    "securityContext": { "$ref": "#/definitions/k8sObject" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "defaultServiceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "manage": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "from": { "type": "array", "items": { "type": "object" } },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "to": { "type": "array", "minItems": 1, "items": { "type": "object" } } }
        },
        "internet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": { "type": "string", "minLength": 1 },
            "except": { "type": "array", "items": { "type": "string" } },
            "tcpPorts": { "type": "array", "items": { "$ref": "#/definitions/port" } },
            "udp": { "type": "boolean" }
          }
        },
        "extraIngress": { "type": "array", "items": { "type": "object" } },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "extraObjects": { "type": "array", "items": { "type": "object" } }
  }
}
